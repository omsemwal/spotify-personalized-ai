# Core Infrastructure Services Configuration

# Operational Postgres Database Configuration
POSTGRES_DB=memory_system
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_secure
POSTGRES_HOST=localhost
# 5433 on the host: a natively installed PostgreSQL usually owns 5432.
# Services running inside docker-compose override this with 5432.
POSTGRES_PORT=5433

# Neo4j Graph Database Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_password_secure

# Redis Configuration (Idempotency & Caching)
REDIS_HOST=localhost
REDIS_PORT=6379

# Kafka / Redpanda Event Broker
# Host-run services use Redpanda's EXTERNAL listener (19092). Services running
# inside docker-compose override this with the internal listener (redpanda:9092).
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
KAFKA_INTERACTION_EVENTS_TOPIC=interaction-events

# Qdrant Vector Store Configuration
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Service Port Allocations
INGESTION_API_PORT=8001
RETRIEVAL_API_PORT=8002
CONTEXT_COMPOSER_PORT=8003
DELETION_ORCHESTRATOR_PORT=8004
MCP_SERVER_PORT=8005
MEMORY_PROCESSOR_PORT=8006
MEMORY_CONTROLS_FRONTEND_PORT=3000
MEMORY_CONSOLE_FRONTEND_PORT=3001

# System Security & Privacy Settings
STRICT_CONSENT_CHECK=true
DEFAULT_POLICY_CLASS=normal
ENFORCE_SUBJECT_ISOLATION=true

# Dependency timeouts, in seconds (milliseconds for Kafka). These bound how
# long a service waits before declaring a datastore unreachable. The defaults
# suit a real deployment; the test suite turns them down so a dead port fails
# fast instead of looking like a slow network.
#
# There is deliberately no LOCAL_MODE setting any more. It used to make every
# service fall back to in-process dictionaries, which meant a dead database
# looked exactly like a healthy one. Services now refuse to start without their
# datastores, and tests inject doubles explicitly. See docs/PLAN.md U4.
NEO4J_CONNECTION_TIMEOUT=5
NEO4J_MAX_RETRY_TIME=5
POSTGRES_CONNECT_TIMEOUT=5
REDIS_CONNECT_TIMEOUT=2
KAFKA_MAX_BLOCK_MS=5000

# Ingestion API service-to-service auth (pilot: static token — see
# services/ingestion-api/auth.py; replace with real workload identity before
# any non-synthetic deployment)
INGESTION_SERVICE_TOKEN=dev-ingestion-token

# Retrieval API embedding backend: local_hash (default, no network required)
# or sentence_transformers (downloads all-MiniLM-L6-v2 — needs network)
EMBEDDING_BACKEND=local_hash

# Origins allowed to call the APIs from a browser. Add your frontend's origin
# here (dev server and deployed URL). "null" covers pages opened from disk.
# Narrow this to real surface origins before any non-pilot deployment.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://127.0.0.1:3000,null

# External Service Keys
# Structured-output model used for memory extraction (§5.4 "deterministic rules
# plus structured model output", §7.5). Leave blank to run extraction on the
# deterministic rules alone — the service degrades, it does not fail.
GEMINI_API_KEY=your_gemini_api_key_here
EXTRACTION_MODEL=gemini-2.5-flash
