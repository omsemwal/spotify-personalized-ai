# Copy this file to .env and fill in real values.
# abc.md:246 - commit only a safe .env.example, never real secrets.

# --- Auth -----------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
MEMORY_JWT_SECRET=replace-me-with-a-long-random-string

# --- PostgreSQL -----------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=spotify_personalized_ai
POSTGRES_SSL=false

# --- Redis ----------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=3
REDIS_SSL=false
REDIS_PREFIX=spotifymem

# --- Optional overrides ---------------------------------------------------
# A ready-made connection string wins over the fields above.

