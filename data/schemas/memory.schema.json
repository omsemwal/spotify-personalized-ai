{
  "description": "A single versioned memory fact \u2014 the unit stored in both the graph and the\nvector index under the same `memory_id` (\u00a75.4 \"Embeddings and Retrieval\").",
  "properties": {
    "memory_id": {
      "description": "Stable identifier shared across graph + vector store",
      "title": "Memory Id",
      "type": "string"
    },
    "subject_id": {
      "title": "Subject Id",
      "type": "string"
    },
    "fact_text": {
      "description": "Canonical natural-language statement of the fact",
      "title": "Fact Text",
      "type": "string"
    },
    "memory_type": {
      "enum": [
        "episode",
        "explicit_preference",
        "candidate_preference",
        "exclusion",
        "correction"
      ],
      "title": "Memory Type",
      "type": "string"
    },
    "entities": {
      "description": "Resolved canonical entity identifiers",
      "items": {
        "type": "string"
      },
      "title": "Entities",
      "type": "array"
    },
    "confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "policy_class": {
      "default": "normal",
      "enum": [
        "normal",
        "sensitive",
        "blocked"
      ],
      "title": "Policy Class",
      "type": "string"
    },
    "source_event_id": {
      "title": "Source Event Id",
      "type": "string"
    },
    "valid_from": {
      "format": "date-time",
      "title": "Valid From",
      "type": "string"
    },
    "valid_to": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Valid To"
    },
    "recorded_at": {
      "format": "date-time",
      "title": "Recorded At",
      "type": "string"
    },
    "status": {
      "default": "active",
      "enum": [
        "active",
        "superseded",
        "expired",
        "deleted"
      ],
      "title": "Status",
      "type": "string"
    },
    "surface": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Surface this memory is eligible for; None = all",
      "title": "Surface"
    }
  },
  "required": [
    "memory_id",
    "subject_id",
    "fact_text",
    "memory_type",
    "confidence",
    "source_event_id",
    "valid_from",
    "recorded_at"
  ],
  "title": "Memory",
  "type": "object"
}